    {
      "now_ns": 30000000000,
      "detections": [
        {
          "track_id": 5,
          "conf": 0.4
        },
        {
          "track_id": 5,
          "conf": 0.45
        }
      ],
      "expected_events": [
        {
          "track_id": 5,
          "confidence": 0.4
