# Python cache and build artifacts
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test and lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editor and OS files
.vscode/settings.json
.DS_Store
Thumbs.db

# Engine manager runtime files (camera URIs with passwords, the engine's spool)
data/run/
data/backups/*
!data/backups/.gitkeep

# Local environment files
.env
.env.*
!.env.example

# Runtime logs (rotated backups are named app.log.1, app.log.2, ... so ignore the whole dir)
*.log
logs/*
!logs/.gitkeep

# Runtime snapshots
 # Runtime snapshots
data/snapshots/*
!data/snapshots/.gitkeep

# Ignore local videos and snapshots by default
data/videos/*
!data/videos/.gitkeep

# Environment files
.env
.env.*

# Local test videos
data/videos/*
!data/videos/.gitkeep

# YOLO model weights (auto-downloaded by ultralytics on first run if missing)
*.pt

# Personal files: CV and interview prep (keep local, never push)
myCV/
interview/

# Claude project instructions (keep local, never push)
CLAUDE.md

# Personal dev roadmap/planning notes (keep local, never push)
ROADMAP.md
# Personal study guide to this project (keep local, never push)
HOC_DU_AN.md
# ONNX models and TensorRT engines (regenerate: engine/tools/export_yolov8_onnx.py, nvinfer)
*.onnx
*.engine
# ...but not the engine's Dockerfile, whose name ends the same way
!deploy/Dockerfile.engine
