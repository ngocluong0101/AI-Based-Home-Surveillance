# Python cache and build artifacts
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test and lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editor and OS files
.vscode/settings.json
.DS_Store
Thumbs.db

# Local environment files
.env
.env.*
!.env.example

# Runtime logs (rotated backups are named app.log.1, app.log.2, ... so ignore the whole dir)
*.log
logs/*
!logs/.gitkeep

# Runtime snapshots
 # Runtime snapshots
data/snapshots/*
!data/snapshots/.gitkeep

# Ignore local videos and snapshots by default
data/videos/*
!data/videos/.gitkeep

# Environment files
.env
.env.*

# Local test videos
data/videos/*
!data/videos/.gitkeep

# YOLO model weights (auto-downloaded by ultralytics on first run if missing)
*.pt