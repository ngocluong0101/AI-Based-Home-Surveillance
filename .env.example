# Application environment
APP_ENV=development

# Input source placeholders
VIDEO_SOURCE=webcam
RTSP_URL=
MP4_PATH=

# Notification placeholders
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telegram bot token and chat id for notifications.
# Leave these blank in source control. Create a local `.env` from
# this file and fill with your bot token and the target chat id.

# App configuration (non-sensitive defaults)
# Confidence threshold for person detection (float)
CONFIDENCE_THRESHOLD=0.5
# Delay in seconds between RTSP reconnect attempts (float)
RECONNECT_DELAY=5.0
# Absence timeout in seconds for PERSON_DETECTED re-emission (float)
ABSENCE_TIMEOUT=10.0
# Enable/disable telegram notifications (true/false)
ENABLE_TELEGRAM=false 
# Enable/disable saving snapshots to disk (true/false)
ENABLE_SNAPSHOT=true

# Logging
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Path to the rotating log file
LOG_FILE=logs/app.log
# Max size in bytes before the log file rotates (default: 5MB)
LOG_MAX_BYTES=5242880
# Number of rotated backup log files to keep
LOG_BACKUP_COUNT=3