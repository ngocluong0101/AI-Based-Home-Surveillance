# Backend (FastAPI). PostgreSQL URL; keep the password out of it and use ~/.pgpass or PGPASSWORD
DATABASE_URL=postgresql+psycopg://surveillance@127.0.0.1:5432/surveillance
# Shared secret the engine sends as X-Internal-Token; empty = /internal/* is open (LAN only)
INTERNAL_TOKEN=

# Engine manager (starts ds_engine for the cameras that should run). Unset ENGINE_MANAGER_URL = the backend
# only records which cameras should run. See README, "Engine manager".
ENGINE_MANAGER_URL=http://127.0.0.1:8100
# The program to start; when the engine runs in the DeepStream container this is the whole `docker run ...
# ds_engine` prefix (mount ENGINE_RUNTIME_DIR, SNAPSHOT_DIR and the config files at the same absolute paths,
# and pass `-e DS_ENGINE_TOKEN` through)
ENGINE_COMMAND=engine/build/ds_engine
# nvinfer config; the manager starts the engine with a copy of it per number of cameras (one TensorRT
# engine file per N, next to the ONNX file, which must be writable by whoever runs the engine)
ENGINE_CONFIG=engine/configs/pgie_yolov8n.txt
ENGINE_TRACKER_CONFIG=engine/configs/tracker_nvdcf.yml
# Holds cameras.ini (with the camera URIs, mode 600) and the engine's spool file
ENGINE_RUNTIME_DIR=data/run
ENGINE_BACKEND_URL=http://127.0.0.1:8000/internal/events
# Where the engine POSTs its heartbeat (camera states); unset = next to ENGINE_BACKEND_URL, with /internal/heartbeat
ENGINE_HEARTBEAT_URL=
# Seconds after which an old heartbeat no longer counts (the engine sends one every 5)
HEARTBEAT_STALE_AFTER=15
# Live video. The engine publishes each camera, with boxes and track IDs drawn, over RTMP to MediaMTX at
# ENGINE_STREAM_URL/cam<ID> (empty = no video). The URL must end with the path prefix (MEDIAMTX_PATH_PREFIX).
ENGINE_STREAM_URL=
# Where browsers reach MediaMTX's WebRTC port (8889), as seen from the browser; unset = GET .../stream answers 503
MEDIAMTX_WEBRTC_URL=
MEDIAMTX_PATH_PREFIX=live
# Extra arguments for ds_engine, split like a shell would
ENGINE_EXTRA_ARGS=

# Notification placeholders
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telegram bot token and chat id for notifications.
# Leave these blank in source control. Create a local `.env` from
# this file and fill with your bot token and the target chat id.

# App configuration (non-sensitive defaults)
# Absence timeout in seconds for PERSON_DETECTED re-emission (float)
ABSENCE_TIMEOUT=10.0
# Enable/disable telegram notifications (true/false)
ENABLE_TELEGRAM=false
# Seconds an event may wait for its Telegram alert before it is marked failed (Telegram down) instead of sent late
NOTIFY_MAX_AGE=600
# Enable/disable saving snapshots to disk (true/false)
ENABLE_SNAPSHOT=true
# Snapshot retention (in days; older snapshots are auto-deleted to prevent disk exhaustion)
SNAPSHOT_RETENTION_DAYS=7
# Run snapshot cleanup every N newly saved snapshots (avoids too-frequent disk scans)
SNAPSHOT_CLEANUP_INTERVAL=100

# Logging
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Path to the rotating log file
LOG_FILE=logs/app.log
# Max size in bytes before the log file rotates (default: 5MB)
LOG_MAX_BYTES=5242880
# Number of rotated backup log files to keep
LOG_BACKUP_COUNT=3

# --- Docker Compose only (deploy/compose.yml, README "Docker") ---
# The containers get DATABASE_URL, ENGINE_* and the paths from the compose file, so the values above that
# configure them (DATABASE_URL, ENGINE_*, SNAPSHOT_DIR, LOG_*) are ignored there. Telegram, ABSENCE_TIMEOUT
# and SNAPSHOT_RETENTION_DAYS are taken from here.
# Password of the PostgreSQL container: letters and digits only (it is put into a URL)
POSTGRES_PASSWORD=
# Shared secret between the engine and the backend (/internal/*), for example: openssl rand -hex 24
# (INTERNAL_TOKEN above is used for it too)
# The address browsers use to reach this machine; WebRTC video does not work without the right one
PUBLIC_HOST=localhost
# Port of the web app on the host
HTTP_PORT=8080
# Database backup (the "backup" container): a dump every BACKUP_INTERVAL_SECONDS, the newest BACKUP_KEEP kept in
# BACKUP_PATH (relative to deploy/compose.yml). Defaults: a day, 7, ../data/backups. See README, "Docker".
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_KEEP=7
# BACKUP_PATH=../data/backups